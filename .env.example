# Copy to .env and adjust. Every value has a safe default for local development.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Storage (defaults: local SQLite + in-process KV + in-memory vectors)
# DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support
# REDIS_URL=redis://localhost:6379/0
# VECTOR_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333

# ---------------------------------------------------------------- LLM
# mock       = offline rule-based planner (no key, default)
# FREE:  groq | gemini | openrouter | cerebras | mistral | ollama (local)
# PAID:  openai      ANY OpenAI-compatible server: custom (+ LLM_BASE_URL)
# Check your setup with:  python scripts/check_llm.py   (--list shows all providers)
LLM_PROVIDER=mock
# LLM_MODEL=                   # override the provider's default model
# LLM_FALLBACK_PROVIDERS=      # e.g. gemini,openrouter,mock - used when the primary fails / rate-limits

# Only set the key(s) for the provider(s) you use:
# GROQ_API_KEY=gsk_...         # free: https://console.groq.com/keys
# GEMINI_API_KEY=...           # free: https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=sk-or-... # free models: https://openrouter.ai/keys
# CEREBRAS_API_KEY=csk-...     # free: https://cloud.cerebras.ai
# MISTRAL_API_KEY=...          # free plan: https://console.mistral.ai/api-keys
# OLLAMA_BASE_URL=http://localhost:11434/v1   # local: `ollama pull qwen3:8b`
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL= / LLM_API_KEY= # for LLM_PROVIDER=custom (vLLM, LM Studio, LiteLLM...)

# ---------------------------------------------------------- Embeddings
# hashing (offline, free, default) | gemini | mistral | ollama | openai | custom
# Groq / OpenRouter / Cerebras have no embeddings API: keep hashing or pick a free one above.
EMBEDDING_PROVIDER=hashing
# EMBEDDING_MODEL=             # override, e.g. nomic-embed-text for ollama

# key:role pairs. client = customer-facing apps, admin = support staff / ops tooling
API_KEYS=dev-client-key:client,dev-admin-key:admin
RATE_LIMIT_PER_MINUTE=60

# Optional integrations
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=xoxb-...
# ESCALATION_WEBHOOK_URL=https://hooks.slack.com/services/...

SEED_DEMO_DATA=true
